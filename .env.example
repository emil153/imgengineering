# Copy to .env.local (development) or set in the hosting dashboard (production).
# Never commit real values.

# ── Quote form delivery ─────────────────────────────────────────────
# At least ONE channel must be configured, otherwise the form answers
# "temporarily unavailable" (HTTP 503) instead of pretending to send.

# Channel 1: email to IMG via Brevo transactional API
BREVO_API_KEY=
# Must be a sender/domain verified in Brevo (e.g. website@imgengi.com)
QUOTE_SENDER_EMAIL=
QUOTE_SENDER_NAME="Сайт IMG Engineering"
# Comma-separated recipients. Default: office@imgengi.com
QUOTE_NOTIFY_TO=office@imgengi.com
# Send a "we received your request" email to the visitor (true/false)
QUOTE_SEND_CONFIRMATION=false

# Channel 2: JSON webhook, e.g. a Make.com "Custom webhook" for CRM / Google Sheets / automation
QUOTE_WEBHOOK_URL=

# Testing only: point Brevo calls at a mock server
# BREVO_API_URL=http://localhost:4010/brevo
